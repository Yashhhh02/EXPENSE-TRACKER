# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter Model Routing (Free-tier models)
OPENROUTER_CATEGORIZE_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_ADVISOR_MODEL=nvidia/nemotron-3-super
OPENROUTER_REPORT_MODEL=google/gemma-4-31b
# Optional content safety moderator: nvidia/nemotron-3.5-content-safety
